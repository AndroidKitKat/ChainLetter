{"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText\/combine(_:weights:)","doc:\/\/ChainLetter\/documentation\/ChainLetter\/Chain\/combine(_:weights:)","doc:\/\/ChainLetter\/documentation\/ChainLetter\/Chain\/CombineError"],"title":"Related Documentation"},{"anchor":"Advanced-Usage","generated":true,"identifiers":["doc:\/\/ChainLetter\/documentation\/ChainLetter\/CustomizingSentenceSplitting","doc:\/\/ChainLetter\/documentation\/ChainLetter\/PersistingModels"],"title":"Advanced Usage"}],"kind":"article","sections":[],"abstract":[{"type":"text","text":"Blend multiple text sources to create hybrid generators."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/CombiningModels","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"ChainLetter allows you to combine multiple Markov models into a single generator. This is useful for blending writing styles, mixing topics, or creating weighted hybrids from different corpora.","type":"text"}]},{"type":"heading","text":"Basic Combination","level":2,"anchor":"Basic-Combination"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText\/combine(_:weights:)","isActive":true,"type":"reference"},{"text":" to merge models:","type":"text"}]},{"type":"codeListing","code":["let sciFi = MarkovText(sciFiCorpus)","let fantasy = MarkovText(fantasyCorpus)","","let blended = try MarkovText.combine([sciFi, fantasy])"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The combined model generates text that draws from both sources with equal probability.","type":"text"}]},{"type":"heading","text":"Weighted Combination","level":2,"anchor":"Weighted-Combination"},{"type":"paragraph","inlineContent":[{"text":"Apply weights to control the influence of each source:","type":"text"}]},{"type":"codeListing","code":["let formal = MarkovText(formalWriting)","let casual = MarkovText(casualWriting)","","\/\/ 75% formal, 25% casual influence","let mixed = try MarkovText.combine(","    [formal, casual],","    weights: [3.0, 1.0]",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Weights are relative, so ","type":"text"},{"code":"[3.0, 1.0]","type":"codeVoice"},{"text":" is equivalent to ","type":"text"},{"code":"[0.75, 0.25]","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"[6.0, 2.0]","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","text":"Combining Multiple Sources","level":2,"anchor":"Combining-Multiple-Sources"},{"type":"paragraph","inlineContent":[{"text":"Combine any number of models:","type":"text"}]},{"type":"codeListing","code":["let author1 = MarkovText(corpus1)","let author2 = MarkovText(corpus2)","let author3 = MarkovText(corpus3)","","let mashup = try MarkovText.combine(","    [author1, author2, author3],","    weights: [2.0, 1.0, 1.0]  \/\/ author1 has 2x influence",")"],"syntax":"swift"},{"type":"heading","text":"Requirements and Constraints","level":2,"anchor":"Requirements-and-Constraints"},{"type":"heading","text":"Same State Size","level":3,"anchor":"Same-State-Size"},{"type":"paragraph","inlineContent":[{"text":"All models must have the same ","type":"text"},{"code":"stateSize","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["let model1 = MarkovText(text1, stateSize: 2)","let model2 = MarkovText(text2, stateSize: 3)","","\/\/ This throws Chain.CombineError.mismatchedStateSizes","let combined = try MarkovText.combine([model1, model2])"],"syntax":"swift"},{"type":"heading","text":"Uncompiled Models Only","level":3,"anchor":"Uncompiled-Models-Only"},{"type":"paragraph","inlineContent":[{"text":"Compiled models cannot be combined:","type":"text"}]},{"type":"codeListing","code":["var model = MarkovText(corpus)","model.compile()","","\/\/ This throws Chain.CombineError.compiledChainNotSupported","let combined = try MarkovText.combine([model, otherModel])"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Combine models first, then compile the result if needed.","type":"text"}]},{"type":"heading","text":"Error Handling","level":2,"anchor":"Error-Handling"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"combine","type":"codeVoice"},{"text":" method throws ","type":"text"},{"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/Chain\/CombineError","isActive":true,"type":"reference"},{"text":" for invalid inputs:","type":"text"}]},{"type":"codeListing","code":["do {","    let combined = try MarkovText.combine([model1, model2])","} catch Chain.CombineError.emptyModels {","    print(\"No models provided\")","} catch Chain.CombineError.mismatchedStateSizes(let sizes) {","    print(\"State sizes don't match: \\(sizes)\")","} catch Chain.CombineError.compiledChainNotSupported {","    print(\"Cannot combine compiled models\")","}"],"syntax":"swift"},{"type":"heading","text":"How Combination Works","level":2,"anchor":"How-Combination-Works"},{"type":"paragraph","inlineContent":[{"text":"When models are combined, their transition counts are merged:","type":"text"}]},{"type":"codeListing","code":["Model A: \"hello\" → [\"world\": 3, \"there\": 1]","Model B: \"hello\" → [\"world\": 1, \"friend\": 2]","","Combined: \"hello\" → [\"world\": 4, \"there\": 1, \"friend\": 2]"],"syntax":null},{"type":"paragraph","inlineContent":[{"text":"With weights, counts are multiplied before merging:","type":"text"}]},{"type":"codeListing","code":["Model A (weight 2.0): \"hello\" → [\"world\": 6, \"there\": 2]","Model B (weight 1.0): \"hello\" → [\"world\": 1, \"friend\": 2]","","Combined: \"hello\" → [\"world\": 7, \"there\": 2, \"friend\": 2]"],"syntax":null},{"type":"heading","text":"Overlap Checking in Combined Models","level":2,"anchor":"Overlap-Checking-in-Combined-Models"},{"type":"paragraph","inlineContent":[{"text":"When models are combined, their parsed sentences are also merged (if ","type":"text"},{"code":"retainOriginal","type":"codeVoice"},{"type":"text","text":" was true). This means overlap checking works against all source corpora:"}]},{"type":"codeListing","code":["let model1 = MarkovText(text1, retainOriginal: true)","let model2 = MarkovText(text2, retainOriginal: true)","","let combined = try MarkovText.combine([model1, model2])","","\/\/ Overlap checking works against both text1 and text2","if let sentence = combined.makeSentence() {","    print(sentence)","}"],"syntax":"swift"},{"type":"heading","text":"Combining at the Chain Level","level":2,"anchor":"Combining-at-the-Chain-Level"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For lower-level control, combine "},{"isActive":true,"type":"reference","identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/Chain"},{"type":"text","text":" objects directly:"}]},{"type":"codeListing","code":["let chain1 = Chain(corpus: corpus1, stateSize: 2)","let chain2 = Chain(corpus: corpus2, stateSize: 2)","","let combined = try Chain.combine([chain1, chain2], weights: [1.5, 1.0])","","\/\/ Create MarkovText from the combined chain","let model = MarkovText(chain: combined)"],"syntax":"swift"},{"type":"heading","text":"Use Cases","level":2,"anchor":"Use-Cases"},{"type":"heading","text":"Blending Writing Styles","level":3,"anchor":"Blending-Writing-Styles"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a generator that mixes multiple authors:"}]},{"type":"codeListing","code":["let classicLit = MarkovText(dickensAndAusten)","let modernFiction = MarkovText(contemporaryNovels)","","let blended = try MarkovText.combine(","    [classicLit, modernFiction],","    weights: [1.0, 2.0]  \/\/ More modern influence",")"],"syntax":"swift"},{"text":"Topic Mixing","level":3,"anchor":"Topic-Mixing","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Combine domain-specific corpora:"}]},{"type":"codeListing","code":["let techNews = MarkovText(technologyArticles)","let sportNews = MarkovText(sportsArticles)","","let newsBot = try MarkovText.combine([techNews, sportNews])"],"syntax":"swift"},{"type":"heading","text":"Personality Tuning","level":3,"anchor":"Personality-Tuning"},{"type":"paragraph","inlineContent":[{"text":"Adjust the “personality” of a chatbot by weighting different conversation styles:","type":"text"}]},{"type":"codeListing","code":["let friendly = MarkovText(friendlyDialogue)","let professional = MarkovText(professionalDialogue)","let humorous = MarkovText(comedyDialogue)","","let chatbot = try MarkovText.combine(","    [friendly, professional, humorous],","    weights: [2.0, 1.0, 0.5]",")"],"syntax":"swift"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/ChainLetter\/documentation\/ChainLetter"]]},"variants":[{"paths":["\/documentation\/chainletter\/combiningmodels"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Article","title":"Combining Models","modules":[{"name":"ChainLetter"}],"role":"article"},"references":{"doc://ChainLetter/documentation/ChainLetter/Chain/CombineError":{"url":"\/documentation\/chainletter\/chain\/combineerror","title":"Chain.CombineError","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"CombineError"}],"navigatorTitle":[{"kind":"identifier","text":"CombineError"}],"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/Chain\/CombineError","type":"topic","abstract":[{"type":"text","text":"Error thrown when combining chains fails"}],"kind":"symbol"},"doc://ChainLetter/documentation/ChainLetter":{"abstract":[{"text":"A Swift library for building Markov chain text generators.","type":"text"}],"kind":"symbol","role":"collection","url":"\/documentation\/chainletter","title":"ChainLetter","identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter","type":"topic"},"doc://ChainLetter/documentation/ChainLetter/MarkovText/combine(_:weights:)":{"url":"\/documentation\/chainletter\/markovtext\/combine(_:weights:)","abstract":[{"text":"Combines multiple MarkovText models into a single model with weighted transitions","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText\/combine(_:weights:)","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"combine","kind":"identifier"},{"text":"([","kind":"text"},{"text":"MarkovText","kind":"typeIdentifier","preciseIdentifier":"s:11ChainLetter10MarkovTextV"},{"text":"], ","kind":"text"},{"text":"weights","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":"]?) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:11ChainLetter10MarkovTextV","text":"MarkovText","kind":"typeIdentifier"}],"title":"combine(_:weights:)"},"doc://ChainLetter/documentation/ChainLetter/CustomizingSentenceSplitting":{"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/CustomizingSentenceSplitting","role":"article","title":"Customizing Sentence Splitting","kind":"article","type":"topic","url":"\/documentation\/chainletter\/customizingsentencesplitting","abstract":[{"type":"text","text":"Handle non-standard text formats like chat logs, poetry, and structured data."}]},"doc://ChainLetter/documentation/ChainLetter/Chain/combine(_:weights:)":{"type":"topic","kind":"symbol","abstract":[{"text":"Combines multiple chains into a single chain with weighted transitions","type":"text"}],"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/Chain\/combine(_:weights:)","title":"combine(_:weights:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"combine","kind":"identifier"},{"text":"([","kind":"text"},{"preciseIdentifier":"s:11ChainLetter0A0V","text":"Chain","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"weights","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":"]?) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:11ChainLetter0A0V","text":"Chain","kind":"typeIdentifier"}],"url":"\/documentation\/chainletter\/chain\/combine(_:weights:)","role":"symbol"},"doc://ChainLetter/documentation/ChainLetter/Chain":{"abstract":[{"type":"text","text":"A Markov chain representing a sequence model with explicit begin and end states."},{"type":"text","text":" "},{"type":"text","text":"Used to model processes like sentences that have natural beginnings and endings."}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Chain","kind":"identifier"}],"url":"\/documentation\/chainletter\/chain","navigatorTitle":[{"text":"Chain","kind":"identifier"}],"title":"Chain","identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/Chain","type":"topic"},"doc://ChainLetter/documentation/ChainLetter/PersistingModels":{"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/PersistingModels","role":"article","title":"Persisting Models","kind":"article","type":"topic","url":"\/documentation\/chainletter\/persistingmodels","abstract":[{"text":"Save and load Markov models for later use.","type":"text"}]}}}