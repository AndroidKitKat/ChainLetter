{"hierarchy":{"paths":[["doc:\/\/ChainLetter\/documentation\/ChainLetter"]]},"abstract":[{"type":"text","text":"Generate sentences with various constraints and options."}],"seeAlsoSections":[{"identifiers":["doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText\/makeSentence(initState:tries:maxOverlapRatio:maxOverlapTotal:testOutput:maxWords:minWords:)","doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText\/makeShortSentence(maxChars:minChars:tries:maxOverlapRatio:maxOverlapTotal:testOutput:)","doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText\/makeSentenceWithStart(_:strict:tries:maxOverlapRatio:maxOverlapTotal:testOutput:)"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/ChainLetter\/documentation\/ChainLetter\/GettingStarted","doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText"],"anchor":"Essentials","title":"Essentials","generated":true}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"ChainLetter provides several methods for generating text, from simple random sentences to length-constrained output suitable for tweets or UI elements.","type":"text"}]},{"type":"heading","text":"Basic Sentence Generation","level":2,"anchor":"Basic-Sentence-Generation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText\/makeSentence(initState:tries:maxOverlapRatio:maxOverlapTotal:testOutput:maxWords:minWords:)"},{"type":"text","text":" method generates a single sentence:"}]},{"type":"codeListing","code":["if let sentence = model.makeSentence() {","    print(sentence)","}"],"syntax":"swift"},{"type":"heading","text":"Controlling Attempts","level":3,"anchor":"Controlling-Attempts"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Generation may fail if the random walk produces text too similar to the original corpus. Increase "},{"code":"tries","type":"codeVoice"},{"type":"text","text":" for difficult corpora:"}]},{"type":"codeListing","code":["if let sentence = model.makeSentence(tries: 50) {","    print(sentence)","}"],"syntax":"swift"},{"type":"heading","text":"Word Count Constraints","level":3,"anchor":"Word-Count-Constraints"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Limit the length of generated sentences by word count:"}]},{"type":"codeListing","code":["\/\/ At least 5 words","if let sentence = model.makeSentence(minWords: 5) {","    print(sentence)","}","","\/\/ Between 5 and 15 words","if let sentence = model.makeSentence(minWords: 5, maxWords: 15) {","    print(sentence)","}"],"syntax":"swift"},{"type":"heading","text":"Character-Limited Sentences","level":2,"anchor":"Character-Limited-Sentences"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText\/makeShortSentence(maxChars:minChars:tries:maxOverlapRatio:maxOverlapTotal:testOutput:)"},{"type":"text","text":" when you need sentences that fit within a character limit:"}]},{"type":"codeListing","code":["\/\/ Tweet-length (max 280 characters)","if let tweet = model.makeShortSentence(maxChars: 280) {","    print(tweet)","}","","\/\/ Between 100 and 280 characters","if let tweet = model.makeShortSentence(maxChars: 280, minChars: 100) {","    print(tweet)","}"],"syntax":"swift"},{"type":"heading","text":"Starting with a Specific Phrase","level":2,"anchor":"Starting-with-a-Specific-Phrase"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText\/makeSentenceWithStart(_:strict:tries:maxOverlapRatio:maxOverlapTotal:testOutput:)"},{"type":"text","text":" to generate sentences beginning with a specific word or phrase:"}]},{"type":"codeListing","code":["if let sentence = model.makeSentenceWithStart(\"The quick\") {","    print(sentence)","    \/\/ \"The quick brown fox jumps over the lazy dog.\"","}"],"syntax":"swift"},{"type":"heading","text":"Strict vs. Non-Strict Mode","level":3,"anchor":"Strict-vs-Non-Strict-Mode"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"type":"text","text":"strict mode"}]},{"text":" (default), the phrase must appear at the beginning of sentences in your corpus:","type":"text"}]},{"type":"codeListing","code":["\/\/ Only works if sentences start with \"Once upon\"","if let sentence = model.makeSentenceWithStart(\"Once upon\", strict: true) {","    print(sentence)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"type":"strong","inlineContent":[{"text":"non-strict mode","type":"text"}]},{"type":"text","text":", the phrase can appear anywhere in the model’s states:"}]},{"type":"codeListing","code":["\/\/ Works if \"brown fox\" appears anywhere","if let sentence = model.makeSentenceWithStart(\"brown fox\", strict: false) {","    print(sentence)","}"],"syntax":"swift"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The starting phrase must contain at most ","type":"text"},{"code":"stateSize","type":"codeVoice"},{"text":" words.","type":"text"}]}],"style":"note","type":"aside","name":"Note"},{"type":"heading","text":"Overlap Detection","level":2,"anchor":"Overlap-Detection"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default, ChainLetter rejects sentences that too closely match the original corpus. This prevents generating exact copies of your input."}]},{"anchor":"How-It-Works","type":"heading","text":"How It Works","level":3},{"type":"paragraph","inlineContent":[{"text":"The algorithm checks if any contiguous sequence of words in the generated sentence appears in the original text. The thresholds are:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"maxOverlapRatio","type":"text"}]},{"text":": Maximum overlap as a fraction of sentence length (default: 0.7)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"maxOverlapTotal","type":"text"}]},{"text":": Maximum absolute overlap in words (default: 15)","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The effective limit is the smaller of these two values.","type":"text"}]},{"anchor":"Adjusting-Thresholds","type":"heading","text":"Adjusting Thresholds","level":3},{"type":"paragraph","inlineContent":[{"text":"For more original output, use stricter thresholds:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["if let sentence = model.makeSentence(","    maxOverlapRatio: 0.5,  \/\/ Max 50% overlap","    maxOverlapTotal: 8     \/\/ Max 8 words",") {","    print(sentence)","}"]},{"anchor":"Disabling-Overlap-Checking","type":"heading","text":"Disabling Overlap Checking","level":3},{"type":"paragraph","inlineContent":[{"text":"For maximum generation success (at the cost of potentially copying the source), disable checking entirely:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["if let sentence = model.makeSentence(testOutput: false) {","    print(sentence)","}"]},{"type":"aside","name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Disabling overlap checking is useful for small corpora where overlap is unavoidable, but the output may be identical to your source text."}]}]},{"anchor":"Performance-Optimization","type":"heading","text":"Performance Optimization","level":2},{"type":"paragraph","inlineContent":[{"text":"For applications that generate many sentences, compile the model first:","type":"text"}]},{"type":"codeListi