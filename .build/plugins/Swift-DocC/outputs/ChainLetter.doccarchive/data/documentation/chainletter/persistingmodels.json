{"abstract":[{"text":"Save and load Markov models for later use.","type":"text"}],"variants":[{"paths":["\/documentation\/chainletter\/persistingmodels"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/PersistingModels","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/ChainLetter\/documentation\/ChainLetter"]]},"sections":[],"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText","doc:\/\/ChainLetter\/documentation\/ChainLetter\/Chain"]},{"title":"Advanced Usage","generated":true,"anchor":"Advanced-Usage","identifiers":["doc:\/\/ChainLetter\/documentation\/ChainLetter\/CustomizingSentenceSplitting","doc:\/\/ChainLetter\/documentation\/ChainLetter\/CombiningModels"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Building a Markov model from a large corpus can take time. ChainLetter supports full ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" conformance, allowing you to save trained models to disk and reload them instantly.","type":"text"}]},{"anchor":"Saving-a-Model","level":2,"text":"Saving a Model","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use Swift’s ","type":"text"},{"code":"JSONEncoder","type":"codeVoice"},{"text":" to serialize a model:","type":"text"}]},{"syntax":"swift","code":["import ChainLetter","import Foundation","","\/\/ Train the model","let model = MarkovText(largeCorpus)","","\/\/ Encode to JSON","let encoder = JSONEncoder()","encoder.outputFormatting = .prettyPrinted  \/\/ Optional: human-readable","let data = try encoder.encode(model)","","\/\/ Write to disk","let url = URL(fileURLWithPath: \"model.json\")","try data.write(to: url)"],"type":"codeListing"},{"type":"heading","level":2,"anchor":"Loading-a-Model","text":"Loading a Model"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"JSONDecoder"},{"type":"text","text":" to restore a saved model:"}],"type":"paragraph"},{"code":["let url = URL(fileURLWithPath: \"model.json\")","let data = try Data(contentsOf: url)","","let decoder = JSONDecoder()","var model = try decoder.decode(MarkovText.self, from: data)","","\/\/ Optional: compile for faster generation","model.compile()","","\/\/ Ready to use","if let sentence = model.makeSentence() {","    print(sentence)","}"],"syntax":"swift","type":"codeListing"},{"text":"What Gets Saved","type":"heading","anchor":"What-Gets-Saved","level":2},{"type":"paragraph","inlineContent":[{"text":"The following data is persisted:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Property"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"stateSize"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The N-gram size"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"chain.model"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"All state transitions with counts"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"parsedSentences"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Original corpus for overlap checking (if "},{"type":"codeVoice","code":"retainOriginal"},{"type":"text","text":" was true)"}]}]]]},{"text":"What Doesn’t Get Saved","type":"heading","level":2,"anchor":"What-Doesnt-Get-Saved"},{"type":"paragraph","inlineContent":[{"text":"The following are ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" persisted:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Property","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Why"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"compiled","type":"codeVoice"},{"text":" state","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Recompute with "},{"code":"compile()","type":"codeVoice"},{"type":"text","text":" after loading"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Custom closures","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Sentence\/word splitters reset to defaults","type":"text"}]}]]]},{"text":"Restoring Custom Closures","type":"heading","level":3,"anchor":"Restoring-Custom-Closures"},{"type":"paragraph","inlineContent":[{"text":"If you used custom splitters, you’ll need to reapply them after loading:","type":"text"}]},{"type":"codeListing","code":["\/\/ Original model with custom splitter","let original = MarkovText(","    corpus,","    sentenceSplitter: myCustomSplitter",")","","\/\/ After loading, the model uses default splitters","var loaded = try decoder.decode(MarkovText.self, from: data)","","\/\/ For generation, this usually doesn't matter since the model","\/\/ is already built. But if you need the same behavior, create","\/\/ a new model with the loaded chain:","let restored = MarkovText(","    chain: loaded.chain,","    parsedSentences: nil  \/\/ Already in the chain",")"],"syntax":"swift"},{"type":"heading","text":"Binary Encoding","level":2,"anchor":"Binary-Encoding"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For smaller file sizes, use a binary encoder like "},{"type":"codeVoice","code":"PropertyListEncoder"},{"type":"text","text":":"}]},{"type":"codeListing","code":["\/\/ Save as binary plist","let encoder = PropertyListEncoder()","encoder.outputFormat = .binary","let data = try encoder.encode(model)","try data.write(to: URL(fileURLWithPath: \"model.plist\"))","","\/\/ Load","let data = try Data(contentsOf: URL(fileURLWithPath: \"model.plist\"))","let model = try PropertyListDecoder().decode(MarkovText.self, from: data)"],"syntax":"swift"},{"type":"heading","text":"Saving Only the Chain","level":2,"anchor":"Saving-Only-the-Chain"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you don’t need overlap checking, save just the chain for a smaller file:"}]},{"type":"codeListing","code":["\/\/ Save only the chain","let chainData = try JSONEncoder().encode(model.chain)","try chainData.write(to: URL(fileURLWithPath: \"chain.json\"))","","\/\/ Load and create MarkovText","let chainData = try Data(contentsOf: URL(fileURLWithPath: \"chain.json\"))","let chain = try JSONDecoder().decode(Chain.self, from: chainData)","let model = MarkovText(chain: chain)"],"syntax":"swift"},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"text":"Without ","type":"text"},{"type":"codeVoice","code":"parsedSentences"},{"text":", overlap checking is disabled. Set ","type":"text"},{"type":"codeVoice","code":"testOutput: false"},{"text":" when generating, or accept that duplicates may occur.","type":"text"}],"type":"paragraph"}]},{"type":"heading","text":"File Size Considerations","level":2,"anchor":"File-Size-Considerations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Model file sizes depend on:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Corpus size"}]},{"text":": Larger corpora produce larger models","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"State size"}]},{"type":"text","text":": Higher state sizes create more unique states"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"retainOriginal"}],"type":"strong"},{"text":": Storing parsed sentences increases file size","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Typical file sizes:"}]},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Corpus Size"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Approximate JSON Size"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"10 KB text","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"50-100 KB","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"100 KB text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"500 KB - 1 MB"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"1 MB text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"5-10 MB"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"text":"To reduce file size:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use binary encoding (PropertyListEncoder)"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Set "},{"type":"codeVoice","code":"retainOriginal: false"},{"text":" if you don’t need overlap checking","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Consider compression (gzip)"}]}]}]},{"anchor":"Compressing-Saved-Models","type":"heading","text":"Compressing Saved Models","level":3},{"code":["import Compression","","\/\/ Save with compression","let data = try JSONEncoder().encode(model)","let compressed = try (data as NSData).compressed(using: .lzfse)","try compressed.write(to: URL(fileURLWithPath: \"model.json.lzfse\"))","","\/\/ Load with decompression","let compressed = try Data(contentsOf: URL(fileURLWithPath: \"model.json.lzfse\"))","let data = try (compressed as NSData).decompressed(using: .lzfse)","let model = try JSONDecoder().decode(MarkovText.self, from: data as Data)"],"syntax":"swift","type":"codeListing"},{"anchor":"App-Bundle-Resources","type":"heading","level":2,"text":"App Bundle Resources"},{"inlineContent":[{"type":"text","text":"Include pre-trained models in your app bundle:"}],"type":"paragraph"},{"code":["guard let url = Bundle.main.url(","    forResource: \"trained_model\",","    withExtension: \"json\"",") else {","    fatalError(\"Model not found in bundle\")","}","","let data = try Data(contentsOf: url)","var model = try JSONDecoder().decode(MarkovText.self, from: data)","model.compile()"],"syntax":"swift","type":"codeListing"},{"type":"heading","text":"Thread Safety","level":2,"anchor":"Thread-Safety"},{"inlineContent":[{"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"type":"reference","identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/Chain","isActive":true},{"text":" conform to ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":", making them safe to use across concurrency domains:","type":"text"}],"type":"paragraph"},{"code":["let model = try JSONDecoder().decode(MarkovText.self, from: data)","","\/\/ Safe to use from multiple tasks","await withTaskGroup(of: String?.self) { group in","    for _ in 0..<10 {","        group.addTask {","            model.makeSentence()","        }","    }","","    for await sentence in group {","        if let sentence {","            print(sentence)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"name":"Important","type":"aside","style":"important","content":[{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"compile()"},{"text":" method mutates the model. Compile before sharing across tasks, or use separate copies.","type":"text"}],"type":"paragraph"}]}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"role":"article","modules":[{"name":"ChainLetter"}],"title":"Persisting Models","roleHeading":"Article"},"kind":"article","references":{"doc://ChainLetter/documentation/ChainLetter/CustomizingSentenceSplitting":{"role":"article","kind":"article","title":"Customizing Sentence Splitting","url":"\/documentation\/chainletter\/custo