{"abstract":[{"type":"text","text":"Blend multiple text sources to create hybrid generators."}],"seeAlsoSections":[{"identifiers":["doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText\/combine(_:weights:)","doc:\/\/ChainLetter\/documentation\/ChainLetter\/Chain\/combine(_:weights:)","doc:\/\/ChainLetter\/documentation\/ChainLetter\/Chain\/CombineError"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/ChainLetter\/documentation\/ChainLetter\/CustomizingSentenceSplitting","doc:\/\/ChainLetter\/documentation\/ChainLetter\/PersistingModels"],"anchor":"Advanced-Usage","title":"Advanced Usage","generated":true}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"ChainLetter allows you to combine multiple Markov models into a single generator. This is useful for blending writing styles, mixing topics, or creating weighted hybrids from different corpora.","type":"text"}],"type":"paragraph"},{"text":"Basic Combination","anchor":"Basic-Combination","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText\/combine(_:weights:)","isActive":true},{"text":" to merge models:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let sciFi = MarkovText(sciFiCorpus)","let fantasy = MarkovText(fantasyCorpus)","","let blended = try MarkovText.combine([sciFi, fantasy])"]},{"inlineContent":[{"text":"The combined model generates text that draws from both sources with equal probability.","type":"text"}],"type":"paragraph"},{"anchor":"Weighted-Combination","text":"Weighted Combination","level":2,"type":"heading"},{"inlineContent":[{"text":"Apply weights to control the influence of each source:","type":"text"}],"type":"paragraph"},{"code":["let formal = MarkovText(formalWriting)","let casual = MarkovText(casualWriting)","","\/\/ 75% formal, 25% casual influence","let mixed = try MarkovText.combine(","    [formal, casual],","    weights: [3.0, 1.0]",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Weights are relative, so ","type":"text"},{"code":"[3.0, 1.0]","type":"codeVoice"},{"text":" is equivalent to ","type":"text"},{"code":"[0.75, 0.25]","type":"codeVoice"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"[6.0, 2.0]"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Combining-Multiple-Sources","text":"Combining Multiple Sources","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Combine any number of models:"}],"type":"paragraph"},{"type":"codeListing","code":["let author1 = MarkovText(corpus1)","let author2 = MarkovText(corpus2)","let author3 = MarkovText(corpus3)","","let mashup = try MarkovText.combine(","    [author1, author2, author3],","    weights: [2.0, 1.0, 1.0]  \/\/ author1 has 2x influence",")"],"syntax":"swift"},{"type":"heading","level":2,"text":"Requirements and Constraints","anchor":"Requirements-and-Constraints"},{"type":"heading","level":3,"text":"Same State Size","anchor":"Same-State-Size"},{"type":"paragraph","inlineContent":[{"text":"All models must have the same ","type":"text"},{"code":"stateSize","type":"codeVoice"},{"type":"text","text":":"}]},{"code":["let model1 = MarkovText(text1, stateSize: 2)","let model2 = MarkovText(text2, stateSize: 3)","","\/\/ This throws Chain.CombineError.mismatchedStateSizes","let combined = try MarkovText.combine([model1, model2])"],"type":"codeListing","syntax":"swift"},{"anchor":"Uncompiled-Models-Only","text":"Uncompiled Models Only","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Compiled models cannot be combined:"}]},{"type":"codeListing","syntax":"swift","code":["var model = MarkovText(corpus)","model.compile()","","\/\/ This throws Chain.CombineError.compiledChainNotSupported","let combined = try MarkovText.combine([model, otherModel])"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Combine models first, then compile the result if needed."}]},{"anchor":"Error-Handling","level":2,"text":"Error Handling","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"combine"},{"text":" method throws ","type":"text"},{"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/Chain\/CombineError","isActive":true,"type":"reference"},{"type":"text","text":" for invalid inputs:"}],"type":"paragraph"},{"type":"codeListing","code":["do {","    let combined = try MarkovText.combine([model1, model2])","} catch Chain.CombineError.emptyModels {","    print(\"No models provided\")","} catch Chain.CombineError.mismatchedStateSizes(let sizes) {","    print(\"State sizes don't match: \\(sizes)\")","} catch Chain.CombineError.compiledChainNotSupported {","    print(\"Cannot combine compiled models\")","}"],"syntax":"swift"},{"type":"heading","text":"How Combination Works","level":2,"anchor":"How-Combination-Works"},{"inlineContent":[{"text":"When models are combined, their transition counts are merged:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["Model A: \"hello\" → [\"world\": 3, \"there\": 1]","Model B: \"hello\" → [\"world\": 1, \"friend\": 2]","","Combined: \"hello\" → [\"world\": 4, \"there\": 1, \"friend\": 2]"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"With weights, counts are multiplied before merging:"}]},{"type":"codeListing","code":["Model A (weight 2.0): \"hello\" → [\"world\": 6, \"there\": 2]","Model B (weight 1.0): \"hello\" → [\"world\": 1, \"friend\": 2]","","Combined: \"hello\" → [\"world\": 7, \"there\": 2, \"friend\": 2]"],"syntax":null},{"type":"heading","level":2,"anchor":"Overlap-Checking-in-Combined-Models","text":"Overlap Checking in Combined Models"},{"type":"paragraph","inlineContent":[{"text":"When models are combined, their parsed sentences are also merged (if ","type":"text"},{"type":"codeVoice","code":"retainOriginal"},{"text":" was true). This means overlap checking works against all source corpora:","type":"text"}]},{"code":["let model1 = MarkovText(text1, retainOriginal: true)","let model2 = MarkovText(text2, retainOriginal: true)","","let combined = try MarkovText.combine([model1, model2])","","\/\/ Overlap checking works against both text1 and text2","if let sentence = combined.makeSentence() {","    print(sentence)","}"],"type":"codeListing","syntax":"swift"},{"text":"Combining at the Chain Level","type":"heading","level":2,"anchor":"Combining-at-the-Chain-Level"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For lower-level control, combine "},{"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/Chain","type":"reference","isActive":true},{"text":" objects directly:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let chain1 = Chain(corpus: corpus1, stateSize: 2)","let chain2 = Chain(corpus: corpus2, stateSize: 2)","","let combined = try Chain.combine([chain1, chain2], weights: [1.5, 1.0])","","\/\/ Create MarkovText from the combined chain","let model = MarkovText(chain: combined)"]},{"anchor":"Use-Cases","type":"heading","text":"Use Cases","level":2},{"level":3,"type":"heading","text":"Blending Writing Styles","anchor":"Blending-Writing-Styles"},{"inlineContent":[{"type":"text","text":"Create a generator that mixes multiple authors:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let classicLit = MarkovText(dickensAndAusten)","let modernFiction = MarkovText(contemporaryNovels)","","let blended = try MarkovText.combine(","    [classicLit, modernFiction],","    weights: [1.0, 2.0]  \/\/ More modern influence",")"]},{"text":"Topic Mixing","type":"heading","level":3,"anchor":"Topic-Mixing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Combine domain-specific corpora:"}]},{"type":"codeListing","syntax":"swift","code":["let techNews = MarkovText(technologyArticles)","let sportNews = MarkovText(sportsArticles)","","let newsBot = try MarkovText.combine([techNews, sportNews])"]},{"anchor":"Personality-Tuning","type":"heading","level":3,"text":"Personality Tuning"},{"inlineContent":[{"type":"text","text":"Adjust the “personality” of a chatbot by weighting different conversation styles:"}],"type":"paragraph"},{"type":"codeListing","code":["let friendly = MarkovText(friendlyDialogue)","let professional = MarkovText(professionalDialogue)","let humorous = MarkovText(comedyDialogue)","","let chatbot = try MarkovText.combine(","    [friendly, professional, humorous],","    weights: [2.0, 1.0, 0.5]",")"],"syntax":"swift"}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Article","modules":[{"name":"ChainLetter"}],"role":"article","title":"Combining Models"},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/CombiningModels"},"kind":"article","hierarchy":{"paths":[["doc:\/\/ChainLetter\/documentation\/ChainLetter"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/chainletter\/combiningmodels"]}],"references":{"doc://ChainLetter/documentation/ChainLetter":{"abstract":[{"type":"text","text":"A Swift library for building Markov chain text generators."}],"kind":"symbol","role":"collection","url":"\/documentation\/chainletter","title":"ChainLetter","identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter","type":"topic"},"doc://ChainLetter/documentation/ChainLetter/Chain/CombineError":{"title":"Chain.CombineError","abstract":[{"type":"text","text":"Error thrown when combining chains fails"}],"fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"CombineError"}],"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/Chain\/CombineError","role":"symbol","url":"\/documentation\/chainletter\/chain\/combineerror","navigatorT