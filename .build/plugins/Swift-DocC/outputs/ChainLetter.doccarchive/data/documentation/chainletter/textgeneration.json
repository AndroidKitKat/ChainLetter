{"kind":"article","abstract":[{"text":"Generate sentences with various constraints and options.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/ChainLetter\/documentation\/ChainLetter"]]},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText\/makeSentence(initState:tries:maxOverlapRatio:maxOverlapTotal:testOutput:maxWords:minWords:)","doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText\/makeShortSentence(maxChars:minChars:tries:maxOverlapRatio:maxOverlapTotal:testOutput:)","doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText\/makeSentenceWithStart(_:strict:tries:maxOverlapRatio:maxOverlapTotal:testOutput:)"],"title":"Related Documentation","anchor":"Related-Documentation"},{"generated":true,"identifiers":["doc:\/\/ChainLetter\/documentation\/ChainLetter\/GettingStarted","doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText"],"anchor":"Essentials","title":"Essentials"}],"metadata":{"roleHeading":"Article","title":"Text Generation","role":"article","modules":[{"name":"ChainLetter"}]},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"ChainLetter provides several methods for generating text, from simple random sentences to length-constrained output suitable for tweets or UI elements.","type":"text"}]},{"type":"heading","text":"Basic Sentence Generation","level":2,"anchor":"Basic-Sentence-Generation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText\/makeSentence(initState:tries:maxOverlapRatio:maxOverlapTotal:testOutput:maxWords:minWords:)","type":"reference","isActive":true},{"type":"text","text":" method generates a single sentence:"}]},{"type":"codeListing","syntax":"swift","code":["if let sentence = model.makeSentence() {","    print(sentence)","}"]},{"type":"heading","text":"Controlling Attempts","level":3,"anchor":"Controlling-Attempts"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Generation may fail if the random walk produces text too similar to the original corpus. Increase "},{"type":"codeVoice","code":"tries"},{"type":"text","text":" for difficult corpora:"}]},{"syntax":"swift","type":"codeListing","code":["if let sentence = model.makeSentence(tries: 50) {","    print(sentence)","}"]},{"level":3,"anchor":"Word-Count-Constraints","text":"Word Count Constraints","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Limit the length of generated sentences by word count:"}]},{"code":["\/\/ At least 5 words","if let sentence = model.makeSentence(minWords: 5) {","    print(sentence)","}","","\/\/ Between 5 and 15 words","if let sentence = model.makeSentence(minWords: 5, maxWords: 15) {","    print(sentence)","}"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Character-Limited-Sentences","type":"heading","text":"Character-Limited Sentences"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText\/makeShortSentence(maxChars:minChars:tries:maxOverlapRatio:maxOverlapTotal:testOutput:)"},{"text":" when you need sentences that fit within a character limit:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Tweet-length (max 280 characters)","if let tweet = model.makeShortSentence(maxChars: 280) {","    print(tweet)","}","","\/\/ Between 100 and 280 characters","if let tweet = model.makeShortSentence(maxChars: 280, minChars: 100) {","    print(tweet)","}"],"type":"codeListing","syntax":"swift"},{"text":"Starting with a Specific Phrase","level":2,"anchor":"Starting-with-a-Specific-Phrase","type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText\/makeSentenceWithStart(_:strict:tries:maxOverlapRatio:maxOverlapTotal:testOutput:)","isActive":true,"type":"reference"},{"type":"text","text":" to generate sentences beginning with a specific word or phrase:"}],"type":"paragraph"},{"syntax":"swift","code":["if let sentence = model.makeSentenceWithStart(\"The quick\") {","    print(sentence)","    \/\/ \"The quick brown fox jumps over the lazy dog.\"","}"],"type":"codeListing"},{"text":"Strict vs. Non-Strict Mode","level":3,"anchor":"Strict-vs-Non-Strict-Mode","type":"heading"},{"inlineContent":[{"type":"text","text":"In "},{"inlineContent":[{"text":"strict mode","type":"text"}],"type":"strong"},{"type":"text","text":" (default), the phrase must appear at the beginning of sentences in your corpus:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Only works if sentences start with \"Once upon\"","if let sentence = model.makeSentenceWithStart(\"Once upon\", strict: true) {","    print(sentence)","}"],"type":"codeListing"},{"inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"type":"text","text":"non-strict mode"}],"type":"strong"},{"text":", the phrase can appear anywhere in the model’s states:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Works if \"brown fox\" appears anywhere","if let sentence = model.makeSentenceWithStart(\"brown fox\", strict: false) {","    print(sentence)","}"],"type":"codeListing"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"The starting phrase must contain at most ","type":"text"},{"type":"codeVoice","code":"stateSize"},{"text":" words.","type":"text"}]}],"name":"Note","type":"aside"},{"text":"Overlap Detection","level":2,"anchor":"Overlap-Detection","type":"heading"},{"inlineContent":[{"type":"text","text":"By default, ChainLetter rejects sentences that too closely match the original corpus. This prevents generating exact copies of your input."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"How-It-Works","text":"How It Works"},{"type":"paragraph","inlineContent":[{"text":"The algorithm checks if any contiguous sequence of words in the generated sentence appears in the original text. The thresholds are:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"maxOverlapRatio"}],"type":"strong"},{"text":": Maximum overlap as a fraction of sentence length (default: 0.7)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"maxOverlapTotal","type":"text"}]},{"type":"text","text":": Maximum absolute overlap in words (default: 15)"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The effective limit is the smaller of these two values."}]},{"level":3,"type":"heading","anchor":"Adjusting-Thresholds","text":"Adjusting Thresholds"},{"type":"paragraph","inlineContent":[{"text":"For more original output, use stricter thresholds:","type":"text"}]},{"code":["if let sentence = model.makeSentence(","    maxOverlapRatio: 0.5,  \/\/ Max 50% overlap","    maxOverlapTotal: 8     \/\/ Max 8 words",") {","    print(sentence)","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Disabling-Overlap-Checking","type":"heading","level":3,"text":"Disabling Overlap Checking"},{"inlineContent":[{"type":"text","text":"For maximum generation success (at the cost of potentially copying the source), disable checking entirely:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["if let sentence = model.makeSentence(testOutput: false) {","    print(sentence)","}"]},{"type":"aside","style":"important","content":[{"inlineContent":[{"type":"text","text":"Disabling overlap checking is useful for small corpora where overlap is unavoidable, but the output may be identical to your source text."}],"type":"paragraph"}],"name":"Important"},{"level":2,"type":"heading","text":"Performance Optimization","anchor":"Performance-Optimization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For applications that generate many sentences, compile the model first:"}]},{"code":["var model = MarkovText(corpus)","model.compile()","","\/\/ Generation is now faster","for _ in 0..<1000 {","    if let sentence = model.makeSentence() {","        print(sentence)","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Compilation pre-computes cumulative probability distributions, improving generation speed by approximately 10-20% for large models.","type":"text"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/TextGeneration"},"variants":[{"paths":["\/documentation\/chainletter\/textgeneration"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://ChainLetter/documentation/ChainLetter/MarkovText/makeShortSentence(maxChars:minChars:tries:maxOverlapRatio:maxOverlapTotal:testOutput:)":{"abstract":[{"type":"text","text":"Generates a sentence with a maximum character length"}],"title":"makeShortSentence(maxChars:minChars:tries:maxOverlapRatio:maxOverlapTotal:testOutput:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"makeShortSentence"},{"kind":"text","text":"("},{"kind":"externalParam","text":"maxChars"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"minChars"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tries"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"text":"maxOverlapRatio","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"maxOverlapTotal","kind":"externalParam"},{"te