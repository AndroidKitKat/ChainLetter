{"sections":[],"metadata":{"title":"Persisting Models","role":"article","roleHeading":"Article","modules":[{"name":"ChainLetter"}]},"abstract":[{"text":"Save and load Markov models for later use.","type":"text"}],"identifier":{"url":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/PersistingModels","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/ChainLetter\/documentation\/ChainLetter"]]},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText","doc:\/\/ChainLetter\/documentation\/ChainLetter\/Chain"],"anchor":"Related-Documentation"},{"identifiers":["doc:\/\/ChainLetter\/documentation\/ChainLetter\/CustomizingSentenceSplitting","doc:\/\/ChainLetter\/documentation\/ChainLetter\/CombiningModels"],"generated":true,"title":"Advanced Usage","anchor":"Advanced-Usage"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/chainletter\/persistingmodels"]}],"kind":"article","primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"Building a Markov model from a large corpus can take time. ChainLetter supports full ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" conformance, allowing you to save trained models to disk and reload them instantly.","type":"text"}],"type":"paragraph"},{"anchor":"Saving-a-Model","text":"Saving a Model","level":2,"type":"heading"},{"inlineContent":[{"text":"Use Swift’s ","type":"text"},{"code":"JSONEncoder","type":"codeVoice"},{"text":" to serialize a model:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import ChainLetter","import Foundation","","\/\/ Train the model","let model = MarkovText(largeCorpus)","","\/\/ Encode to JSON","let encoder = JSONEncoder()","encoder.outputFormatting = .prettyPrinted  \/\/ Optional: human-readable","let data = try encoder.encode(model)","","\/\/ Write to disk","let url = URL(fileURLWithPath: \"model.json\")","try data.write(to: url)"],"syntax":"swift"},{"level":2,"anchor":"Loading-a-Model","type":"heading","text":"Loading a Model"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"JSONDecoder"},{"type":"text","text":" to restore a saved model:"}],"type":"paragraph"},{"code":["let url = URL(fileURLWithPath: \"model.json\")","let data = try Data(contentsOf: url)","","let decoder = JSONDecoder()","var model = try decoder.decode(MarkovText.self, from: data)","","\/\/ Optional: compile for faster generation","model.compile()","","\/\/ Ready to use","if let sentence = model.makeSentence() {","    print(sentence)","}"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":2,"text":"What Gets Saved","anchor":"What-Gets-Saved"},{"inlineContent":[{"type":"text","text":"The following data is persisted:"}],"type":"paragraph"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Property","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"stateSize"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The N-gram size"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"chain.model"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"All state transitions with counts"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"parsedSentences"}]}],[{"inlineContent":[{"text":"Original corpus for overlap checking (if ","type":"text"},{"type":"codeVoice","code":"retainOriginal"},{"type":"text","text":" was true)"}],"type":"paragraph"}]]],"header":"row"},{"level":2,"anchor":"What-Doesnt-Get-Saved","text":"What Doesn’t Get Saved","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following are "},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" persisted:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Property"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Why"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"compiled"},{"text":" state","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Recompute with "},{"type":"codeVoice","code":"compile()"},{"type":"text","text":" after loading"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Custom closures"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Sentence\/word splitters reset to defaults"}],"type":"paragraph"}]]]},{"text":"Restoring Custom Closures","type":"heading","level":3,"anchor":"Restoring-Custom-Closures"},{"type":"paragraph","inlineContent":[{"text":"If you used custom splitters, you’ll need to reapply them after loading:","type":"text"}]},{"type":"codeListing","code":["\/\/ Original model with custom splitter","let original = MarkovText(","    corpus,","    sentenceSplitter: myCustomSplitter",")","","\/\/ After loading, the model uses default splitters","var loaded = try decoder.decode(MarkovText.self, from: data)","","\/\/ For generation, this usually doesn't matter since the model","\/\/ is already built. But if you need the same behavior, create","\/\/ a new model with the loaded chain:","let restored = MarkovText(","    chain: loaded.chain,","    parsedSentences: nil  \/\/ Already in the chain",")"],"syntax":"swift"},{"text":"Binary Encoding","type":"heading","level":2,"anchor":"Binary-Encoding"},{"type":"paragraph","inlineContent":[{"text":"For smaller file sizes, use a binary encoder like ","type":"text"},{"code":"PropertyListEncoder","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["\/\/ Save as binary plist","let encoder = PropertyListEncoder()","encoder.outputFormat = .binary","let data = try encoder.encode(model)","try data.write(to: URL(fileURLWithPath: \"model.plist\"))","","\/\/ Load","let data = try Data(contentsOf: URL(fileURLWithPath: \"model.plist\"))","let model = try PropertyListDecoder().decode(MarkovText.self, from: data)"],"syntax":"swift"},{"text":"Saving Only the Chain","type":"heading","level":2,"anchor":"Saving-Only-the-Chain"},{"type":"paragraph","inlineContent":[{"text":"If you don’t need overlap checking, save just the chain for a smaller file:","type":"text"}]},{"type":"codeListing","code":["\/\/ Save only the chain","let chainData = try JSONEncoder().encode(model.chain)","try chainData.write(to: URL(fileURLWithPath: \"chain.json\"))","","\/\/ Load and create MarkovText","let chainData = try Data(contentsOf: URL(fileURLWithPath: \"chain.json\"))","let chain = try JSONDecoder().decode(Chain.self, from: chainData)","let model = MarkovText(chain: chain)"],"syntax":"swift"},{"content":[{"inlineContent":[{"type":"text","text":"Without "},{"type":"codeVoice","code":"parsedSentences"},{"type":"text","text":", overlap checking is disabled. Set "},{"type":"codeVoice","code":"testOutput: false"},{"type":"text","text":" when generating, or accept that duplicates may occur."}],"type":"paragraph"}],"type":"aside","name":"Note","style":"note"},{"text":"File Size Considerations","type":"heading","level":2,"anchor":"File-Size-Considerations"},{"type":"paragraph","inlineContent":[{"text":"Model file sizes depend on:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Corpus size"}]},{"text":": Larger corpora produce larger models","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"State size"}]},{"text":": Higher state sizes create more unique states","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"retainOriginal"}]},{"text":": Storing parsed sentences increases