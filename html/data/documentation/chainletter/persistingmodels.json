Resources","type":"heading","level":2,"anchor":"App-Bundle-Resources"},{"type":"paragraph","inlineContent":[{"text":"Include pre-trained models in your app bundle:","type":"text"}]},{"type":"codeListing","code":["guard let url = Bundle.main.url(","    forResource: \"trained_model\",","    withExtension: \"json\"",") else {","    fatalError(\"Model not found in bundle\")","}","","let data = try Data(contentsOf: url)","var model = try JSONDecoder().decode(MarkovText.self, from: data)","model.compile()"],"syntax":"swift"},{"text":"Thread Safety","type":"heading","level":2,"anchor":"Thread-Safety"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/Chain","type":"reference"},{"text":" conform to ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":", making them safe to use across concurrency domains:","type":"text"}]},{"type":"codeListing","code":["let model = try JSONDecoder().decode(MarkovText.self, from: data)","","\/\/ Safe to use from multiple tasks","await withTaskGroup(of: String?.self) { group in","    for _ in 0..<10 {","        group.addTask {","            model.makeSentence()","        }","    }","","    for await sentence in group {","        if let sentence {","            print(sentence)","        }","    }","}"],"syntax":"swift"},{"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"compile()"},{"type":"text","text":" method mutates the model. Compile before sharing across tasks, or use separate copies."}],"type":"paragraph"}],"type":"aside","name":"Important","style":"important"}],"kind":"content"}],"references":{"doc://ChainLetter/documentation/ChainLetter":{"role":"collection","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A Swift library for building Markov chain text generators."}