{"kind":"article","hierarchy":{"paths":[["doc:\/\/ChainLetter\/documentation\/ChainLetter"]]},"identifier":{"url":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/PersistingModels","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"ChainLetter"}],"role":"article","title":"Persisting Models","roleHeading":"Article"},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"inlineContent":[{"type":"text","text":"Building a Markov model from a large corpus can take time. ChainLetter supports full "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformance, allowing you to save trained models to disk and reload them instantly."}],"type":"paragraph"},{"type":"heading","text":"Saving a Model","anchor":"Saving-a-Model","level":2},{"inlineContent":[{"type":"text","text":"Use Swift’s "},{"type":"codeVoice","code":"JSONEncoder"},{"type":"text","text":" to serialize a model:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import ChainLetter","import Foundation","","\/\/ Train the model","let model = MarkovText(largeCorpus)","","\/\/ Encode to JSON","let encoder = JSONEncoder()","encoder.outputFormatting = .prettyPrinted  \/\/ Optional: human-readable","let data = try encoder.encode(model)","","\/\/ Write to disk","let url = URL(fileURLWithPath: \"model.json\")","try data.write(to: url)"]},{"level":2,"anchor":"Loading-a-Model","type":"heading","text":"Loading a Model"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"JSONDecoder"},{"type":"text","text":" to restore a saved model:"}]},{"syntax":"swift","type":"codeListing","code":["let url = URL(fileURLWithPath: \"model.json\")","let data = try Data(contentsOf: url)","","let decoder = JSONDecoder()","var model = try decoder.decode(MarkovText.self, from: data)","","\/\/ Optional: compile for faster generation","model.compile()","","\/\/ Ready to use","if let sentence = model.makeSentence() {","    print(sentence)","}"]},{"type":"heading","text":"What Gets Saved","anchor":"What-Gets-Saved","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following data is persisted:"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Property","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"stateSize","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The N-gram size","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"chain.model"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"All state transitions with counts"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"parsedSentences"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Original corpus for overlap checking (if "},{"type":"codeVoice","code":"retainOriginal"},{"type":"text","text":" was true)"}]}]]],"header":"row"},{"text":"What Doesn’t Get Saved","anchor":"What-Doesnt-Get-Saved","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The following are "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"text":" persisted:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Property"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Why"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"compiled"},{"type":"text","text":" state"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Recompute with "},{"type":"codeVoice","code":"compile()"},{"type":"text","text":" after loading"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Custom closures"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Sentence\/word splitters reset to defaults"}]}]]],"type":"table"},{"text":"Restoring Custom Closures","anchor":"Restoring-Custom-Closures","type":"heading","level":3},{"inlineContent":[{"text":"If you used custom splitters, you’ll need to reapply them after loading:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Original model with custom splitter","let original = MarkovText(","    corpus,","    sentenceSplitter: myCustomSplitter",")","","\/\/ After loading, the model uses default splitters","var loaded = try decoder.decode(MarkovText.self, from: data)","","\/\/ For generation, this usually doesn't matter since the model","\/\/ is already built. But if you need the same behavior, create","\/\/ a new model with the loaded chain:","let restored = MarkovText(","    chain: loaded.chain,","    parsedSentences: nil  \/\/ Already in the chain",")"],"type":"codeListing","syntax":"swift"},{"text":"Binary Encoding","anchor":"Binary-Encoding","type":"heading","level":2},{"inlineContent":[{"text":"For smaller file sizes, use a binary encoder like ","type":"text"},{"type":"codeVoice","code":"PropertyListEncoder"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["\/\/ Save as binary plist","let encoder = PropertyListEncoder()","encoder.outputFormat = .binary","let data = try encoder.encode(model)","try data.write(to: URL(fileURLWithPath: \"model.plist\"))","","\/\/ Load","let data = try Data(contentsOf: URL(fileURLWithPath: \"model.plist\"))","let model = try PropertyListDecoder().decode(MarkovText.self, from: data)"],"type":"codeListing","syntax":"swift"},{"text":"Saving Only the Chain","anchor":"Saving-Only-the-Chain","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"If you don’t need overlap checking, save just the chain for a smaller file:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Save only the chain","let chainData = try JSONEncoder().encode(model.chain)","try chainData.write(to: URL(fileURLWithPath: \"chain.json\"))","","\/\/ Load and create MarkovText","let chainData = try Data(contentsOf: URL(fileURLWithPath: \"chain.json\"))","let chain = try JSONDecoder().decode(Chain.self, from: chainData)","let model = MarkovText(chain: chain)"]},{"name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Without "},{"type":"codeVoice","code":"parsedSentences"},{"text":", overlap checking is disabled. Set ","type":"text"},{"type":"codeVoice","code":"testOutput: false"},{"text":" when generating, or accept that duplicates may occur.","type":"text"}]}],"style":"note"},{"type":"heading","anchor":"File-Size-Considerations","level":2,"text":"File Size Considerations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Model file sizes depend on:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Corpus size","type":"text"}]},{"text":": Larger corpora produce larger models","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"State size","type":"text"}]},{"text":": Higher state sizes create more unique states","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"retainOriginal"}]},{"text":": Storing parsed sentences increases file size","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Typical file sizes:"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Corpus Size"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Approximate JSON Size"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"10 KB text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"50-100 KB"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"100 KB text","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"500 KB - 1 MB"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"1 MB text","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"5-10 MB","type":"text"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To reduce file size:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Use binary encoding (PropertyListEncoder)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Set ","type":"text"},{"code":"retainOriginal: false","type":"codeVoice"},{"text":" if you don’t need overlap checking","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Consider compression (gzip)"}]}]}]},{"level":3,"anchor":"Compressing-Saved-Models","type":"heading","text":"Compressing Saved Models"},{"type":"codeListing","code":["import Compression","","\/\/ Save with compression","let data = try JSONEncoder().encode(model)","let compressed = try (data as NSData).compressed(using: .lzfse)","try compressed.write(to: URL(fileURLWithPath: \"model.json.lzfse\"))","","\/\/ Load with decompression","let compressed = try Data(contentsOf: URL(fileURLWithPath: \"model.json.lzfse\"))","let data = try (compressed as NSData).decompressed(using: .lzfse)","let model = try JSONDecoder().decode(MarkovText.self, from: data as Data)"],"syntax":"swift"},{"text":"App Bundle Resources","type":"heading","anchor":"App-Bundle-Resources","level":2},{"type":"paragraph","inlineContent":[{"text":"Include pre-trained models in your app bundle:","type":"text"}]},{"type":"codeListing","code":["guard let url = Bundle.main.url(","    forResource: \"trained_model\",","    withExtension: \"json\"",") else {","    fatalError(\"Model not found in bundle\")","}","","let data = try Data(contentsOf: url)","var model = try JSONDecoder().decode(MarkovText.self, from: data)","model.compile()"],"syntax":"swift"},{"level":2,"anchor":"Thread-Safety","type":"heading","text":"Thread Safety"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText","type":"reference","isActive":true},{"text":" and ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/Chain"},{"text":" conform to ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":", making them safe to use across concurrency domains:","type":"text"}]},{"type":"codeListing","code":["let model = try JSONDecoder().decode(MarkovText.self, from: data)","","\/\/ Safe to use from multiple tasks","await withTaskGroup(of: String?.self) { group in","    for _ in 0..<10 {","        group.addTask {","            model.makeSentence()","        }","    }","","    for await sentence in group {","        if let sentence {","            print(sentence)","        }","    }","}"],"syntax":"swift"},{"style":"important","type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"compile()","type":"codeVoice"},{"text":" method mutates the model. Compile before sharing across tasks, or use separate copies.","type":"text"}]}]}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText","doc:\/\/ChainLetter\/documentation\/ChainLetter\/Chain"],"anchor":"Related-Documentation"},{"title":"Advanced Usage","identifiers":["doc:\/\/ChainLetter\/documentation\/ChainLetter\/CustomizingSentenceSplitting","doc:\/\/ChainLetter\/documentation\/ChainLetter\/CombiningModels"],"anchor":"Advanced-Usage","generated":true}],"abstract":[{"text":"Save and load Markov models for later use.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/chainletter\/persistingmodels"]}],"references":{"doc://ChainLetter/documentation/ChainLetter/MarkovText":{"navigatorTitle":[{"text":"MarkovText","kind":"identifier"}],"abstract":[{"type":"text","text":"A high-level interface for generating t