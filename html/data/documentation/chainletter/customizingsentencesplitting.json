{"kind":"article","hierarchy":{"paths":[["doc:\/\/ChainLetter\/documentation\/ChainLetter"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/CustomizingSentenceSplitting"},"metadata":{"modules":[{"name":"ChainLetter"}],"roleHeading":"Article","title":"Customizing Sentence Splitting","role":"article"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"ChainLetter’s default sentence splitter handles standard prose with periods, question marks, and exclamation points. However, many text sources use different conventions. This guide shows you how to customize text processing for your specific needs."}]},{"type":"heading","level":2,"anchor":"Default-Behavior","text":"Default Behavior"},{"type":"paragraph","inlineContent":[{"text":"By default, ","type":"text"},{"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText","type":"reference","isActive":true},{"text":" uses ","type":"text"},{"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/Splitters\/splitIntoSentences(_:)","type":"reference","isActive":true},{"text":" which:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Splits on "},{"type":"codeVoice","code":"."},{"text":", ","type":"text"},{"code":"?","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"!","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Preserves abbreviations (Mr., Dr., U.S.A.)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Handles titles and initialisms correctly","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Filters sentences that don’t start with a capital letter","type":"text"}]}]}],"type":"unorderedList"},{"type":"codeListing","syntax":"swift","code":["let model = MarkovText(\"Hello world. How are you?\")","\/\/ Produces two sentences: [\"Hello world.\", \"How are you?\"]"]},{"type":"heading","level":2,"anchor":"Custom-Sentence-Splitting","text":"Custom Sentence Splitting"},{"type":"paragraph","inlineContent":[{"text":"Pass a custom ","type":"text"},{"code":"sentenceSplitter","type":"codeVoice"},{"text":" closure to handle non-standard formats.","type":"text"}]},{"type":"heading","level":3,"anchor":"Newline-Delimited-Text","text":"Newline-Delimited Text"},{"type":"paragraph","inlineContent":[{"text":"For chat logs, poetry, lyrics, or any text where each line is a separate “sentence”:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let chatLogs = \"\"\"","hey what's up","not much, you?","just chilling lol","\"\"\"","","let model = MarkovText(","    chatLogs,","    wellFormed: false,  \/\/ Allow lowercase starts","    sentenceSplitter: { text in","        text.components(separatedBy: .newlines)","            .map { $0.trimmingCharacters(in: .whitespaces) }","            .filter { !$0.isEmpty }","    }",")"]},{"type":"heading","level":3,"anchor":"Paragraph-Based-Splitting","text":"Paragraph-Based Splitting"},{"type":"paragraph","inlineContent":[{"text":"For documents where paragraphs are the unit of generation:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let model = MarkovText(","    document,","    sentenceSplitter: { text in","        text.components(separatedBy: \"\\n\\n\")","            .map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }","            .filter { !$0.isEmpty }","    }",")"]},{"type":"heading","level":3,"anchor":"CSV-or-Structured-Data","text":"CSV or Structured Data"},{"type":"paragraph","inlineContent":[{"text":"For structured data sources:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let tweets = \"\"\"","This is tweet one","This is tweet two","Another tweet here","\"\"\"","","let model = MarkovText(","    tweets,","    sentenceSplitter: { text in","        text.components(separatedBy: .newlines)","            .filter { !$0.isEmpty }","    }",")"]},{"type":"heading","level":2,"anchor":"The-wellFormed-Parameter","text":"The wellFormed Parameter"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"wellFormed","type":"codeVoice"},{"text":" parameter controls whether sentences are filtered based on formatting rules.","type":"text"}]},{"type":"heading","level":3,"anchor":"When-wellFormed-is-true-Default","text":"When wellFormed is true (Default)"},{"type":"paragraph","inlineContent":[{"text":"Sentences starting with lowercase letters (except common exceptions like “iPhone”) are rejected:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let model = MarkovText(\"Hello world. this is ignored.\")","\/\/ Only \"Hello world.\" is included"]},{"type":"heading","level":3,"anchor":"When-wellFormed-is-false","text":"When wellFormed is false"},{"type":"paragraph","inlineContent":[{"text":"All non-empty sentences are included:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let model = MarkovText(","    \"Hello world. this is included.\",","    wellFormed: false",")","\/\/ Both sentences are included"]},{"name":"Tip","type":"aside","content":[{"inlineContent":[{"text":"Set ","type":"text"},{"code":"wellFormed: false","type":"codeVoice"},{"text":" for chat logs, informal text, or any corpus where sentences commonly start with lowercase letters.","type":"text"}],"type":"paragraph"}],"style":"tip"},{"type":"heading","level":2,"anchor":"Custom-Word-Splitting","text":"Custom Word Splitting"},{"type":"paragraph","inlineContent":[{"text":"You can also customize how sentences are split into words:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let model = MarkovText(","    corpus,","    wordSplitter: { sentence in","        \/\/ Split on any whitespace","        sentence.components(separatedBy: .whitespaces)","            .filter { !$0.isEmpty }","    }",")"]},{"type":"heading","level":3,"anchor":"Preserving-Punctuation","text":"Preserving Punctuation"},{"type":"paragraph","inlineContent":[{"text":"The default splitter keeps punctuation attached to words. To separate it:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let model = MarkovText(","    corpus,","    wordSplitter: { sentence in","        var result: [String] = []","        let words = sentence.split(separator: \" \")","        for word in words {","            \/\/ Separate trailing punctuation","            let str = String(word)","            if let last = str.last, \".!?,;:\".contains(last) {","                result.append(String(str.dropLast()))","                result.append(String(last))","            } else {","                result.append(str)","            }","        }","        return result","    }",")"]},{"type":"heading","level":2,"anchor":"Custom-Word-Joining","text":"Custom Word Joining"},{"type":"paragraph","inlineContent":[{"text":"Control how words are joined back into sentences:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let model = MarkovText(","    corpus,","    wordJoiner: { words in","        \/\/ Custom joining logic","        words.joined(separator: \" \")","    }",")"]},{"type":"heading","level":2,"anchor":"Complete-Example-Processing-Chat-Logs","text":"Complete Example: Processing Chat Logs"},{"type":"paragraph","inlineContent":[{"text":"Here’s a complete example for processing IRC or Discord chat logs:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import ChainLetter","","let chatLog = \"\"\"","<alice> hey everyone","<bob> sup alice","<alice> not much, just hanging out","<bob> cool cool","<alice> anyone want to play games later?","<bob> sure, sounds fun","\"\"\"","","let model = MarkovText(","    chatLog,","    stateSize: 1,  \/\/ Lower state size for short messages","    wellFormed: false,","    sentenceSplitter: { text in","        text.components(separatedBy: .newlines)","            .compactMap { line -> String? in","                \/\/ Remove the username prefix","                guard let closeBracket = line.firstIndex(of: \">\") else {","                    return nil","                }","                let message = line[line.index(after: closeBracket)...]","                    .trimmingCharacters(in: .whitespaces)","                return message.isEmpty ? nil : message","            }","    }",")","","if let message = model.makeSentence() {","    print(message)","    \/\/ \"anyone want to play games later?\"","}"]}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText\/init(_:stateSize:retainOriginal:wellFormed:sentenceSplitter:wordSplitter:wordJoiner:)","doc:\/\/ChainLetter\/documentation\/ChainLetter\/Splitters"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/ChainLetter\/documentation\/ChainLetter\/CombiningModels","doc:\/\/ChainLetter\/documentation\/ChainLetter\/PersistingModels"],"title":"Advanced Usage","anchor":"Advanced-Usage","generated":true}],"abstract":[{"type":"text","text":"Handle non-standard text formats like chat logs, poetry, and structured data."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/chainletter\/customizingsentencesplitting"]}],"references":{"doc://ChainLetter/documentation/ChainLetter/Splitters/splitIntoSentences(_:)":{"role":"symbol","type":"topic","kind":"symbol","abstract":[],"url":"\/documentation\/chainletter\/splitters\/splitintosentences(_:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"splitIntoSentences","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":") -> ["},{"text":"String","kind":"typeIdentifier","preciseIdentifier"