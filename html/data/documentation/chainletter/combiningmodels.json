{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"ChainLetter allows you to combine multiple Markov models into a single generator. This is useful for blending writing styles, mixing topics, or creating weighted hybrids from different corpora.","type":"text"}]},{"type":"heading","level":2,"text":"Basic Combination","anchor":"Basic-Combination"},{"inlineContent":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText\/combine(_:weights:)","type":"reference","isActive":true},{"type":"text","text":" to merge models:"}],"type":"paragraph"},{"code":["let sciFi = MarkovText(sciFiCorpus)","let fantasy = MarkovText(fantasyCorpus)","","let blended = try MarkovText.combine([sciFi, fantasy])"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The combined model generates text that draws from both sources with equal probability."}]},{"level":2,"anchor":"Weighted-Combination","type":"heading","text":"Weighted Combination"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply weights to control the influence of each source:"}]},{"code":["let formal = MarkovText(formalWriting)","let casual = MarkovText(casualWriting)","","\/\/ 75% formal, 25% casual influence","let mixed = try MarkovText.combine(","    [formal, casual],","    weights: [3.0, 1.0]",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Weights are relative, so ","type":"text"},{"code":"[3.0, 1.0]","type":"codeVoice"},{"text":" is equivalent to ","type":"text"},{"code":"[0.75, 0.25]","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"[6.0, 2.0]","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","level":2,"text":"Combining Multiple Sources","anchor":"Combining-Multiple-Sources"},{"type":"paragraph","inlineContent":[{"text":"Combine any number of models:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let author1 = MarkovText(corpus1)","let author2 = MarkovText(corpus2)","let author3 = MarkovText(corpus3)","","let mashup = try MarkovText.combine(","    [author1, author2, author3],","    weights: [2.0, 1.0, 1.0]  \/\/ author1 has 2x influence",")"]},{"type":"heading","level":2,"text":"Requirements and Constraints","anchor":"Requirements-and-Constraints"},{"type":"heading","level":3,"text":"Same State Size","anchor":"Same-State-Size"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All models must have the same "},{"code":"stateSize","type":"codeVoice"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["let model1 = MarkovText(text1, stateSize: 2)","let model2 = MarkovText(text2, stateSize: 3)","","\/\/ This throws Chain.CombineError.mismatchedStateSizes","let combined = try MarkovText.combine([model1, model2])"]},{"type":"heading","level":3,"text":"Uncompiled Models Only","anchor":"Uncompiled-Models-Only"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Compiled models cannot be combined:"}]},{"syntax":"swift","type":"codeListing","code":["var model = MarkovText(corpus)","model.compile()","","\/\/ This throws Chain.CombineError.compiledChainNotSupported","let combined = try MarkovText.combine([model, otherModel])"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Combine models first, then compile the result if needed."}]},{"type":"heading","level":2,"text":"Error Handling","anchor":"Error-Handling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"combine","type":"codeVoice"},{"type":"text","text":" method throws "},{"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/Chain\/CombineError","type":"reference","isActive":true},{"text":" for invalid inputs:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["do {","    let combined = try MarkovText.combine([model1, model2])","} catch Chain.CombineError.emptyModels {","    print(\"No models provided\")","} catch Chain.CombineError.mismatchedStateSizes(let sizes) {","    print(\"State sizes don't match: \\(sizes)\")","} catch Chain.CombineError.compiledChainNotSupported {","    print(\"Cannot combine compiled models\")","}"]},{"type":"heading","level":2,"text":"How Combination Works","anchor":"How-Combination-Works"},{"inlineContent":[{"type":"text","text":"When models are combined, their transition counts are merged:"}],"type":"paragraph"},{"code":["Model A: \"hello\" → [\"world\": 3, \"there\": 1]","Model B: \"hello\" → [\"world\": 1, \"friend\": 2]","","Combined: \"hello\" → [\"world\": 4, \"there\": 1, \"friend\": 2]"],"syntax":null,"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"With weights, counts are multiplied before merging:"}]},{"syntax":null,"code":["Model A (weight 2.0): \"hello\" → [\"world\": 6, \"there\": 2]","Model B (weight 1.0): \"hello\" → [\"world\": 1, \"friend\": 2]","","Combined: \"hello\" → [\"world\": 7, \"there\": 2, \"friend\": 2]"],"type":"codeListing"},{"level":2,"type":"heading","anchor":"Overlap-Checking-in-Combined-Models","text":"Overlap Checking in Combined Models"},{"inlineContent":[{"text":"When models are combined, their parsed sentences are also merged (if ","type":"text"},{"code":"retainOriginal","type":"codeVoice"},{"type":"text","text":" was true). This means overlap checking works against all source corpora:"}],"type":"paragraph"},{"code":["let model1 = MarkovText(text1, retainOriginal: true)","let model2 = MarkovText(text2, retainOriginal: true)","","let combined = try MarkovText.combine([model1, model2])","","\/\/ Overlap checking works against both text1 and text2","if let sentence = combined.makeSentence() {","    print(sentence)","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Combining-at-the-Chain-Level","text":"Combining at the Chain Level","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"For lower-level control, combine ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/Chain","type":"reference"},{"text":" objects directly:","type":"text"}]},{"syntax":"swift","code":["let chain1 = Chain(corpus: corpus1, stateSize: 2)","let chain2 = Chain(corpus: corpus2, stateSize: 2)","","let combined = try Chain.combine([chain1, chain2], weights: [1.5, 1.0])","","\/\/ Create MarkovText from the combined chain","let model = MarkovText(chain: combined)"],"type":"codeListing"},{"level":2,"type":"heading","anchor":"Use-Cases","text":"Use Cases"},{"level":3,"text":"Blending Writing Styles","type":"heading","anchor":"Blending-Writing-Styles"},{"inlineContent":[{"text":"Create a generator that mixes multiple authors:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let classicLit = MarkovText(dickensAndAusten)","let modernFiction = MarkovText(contemporaryNovels)","","let blended = try MarkovText.combine(","    [classicLit, modernFiction],","    weights: [1.0, 2.0]  \/\/ More modern influence",")"],"type":"codeListing"},{"level":3,"anchor":"Topic-Mixing","text":"Topic Mixing","type":"heading"},{"inlineContent":[{"text":"Combine domain-specific corpora:","type":"text"}],"type":"paragraph"},{"code":["let techNews = MarkovText(technologyArticles)","let sportNews = MarkovText(sportsArticles)","","let newsBot = try MarkovText.combine([techNews, sportNews])"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"Personality Tuning","anchor":"Personality-Tuning","type":"heading"},{"inlineContent":[{"text":"Adjust the “personality” of a chatbot by weighting different conversation styles:","type":"text"}],"type":"paragraph"},{"code":["let friendly = MarkovText(friendlyDialogue)","let professional = MarkovText(professionalDialogue)","let humorous = MarkovText(comedyDialogue)","","let chatbot = try MarkovText.combine(","    [friendly, professional, humorous],","    weights: [2.0, 1.0, 0.5]",")"],"type":"codeListing","syntax":"swift"}]}],"variants":[{"paths":["\/documentation\/chainletter\/combiningmodels"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Article","title":"Combining Models","modules":[{"name":"ChainLetter"}],"role":"article"},"abstract":[{"text":"Blend multiple text sources to create hybrid generators.","type":"text"}],"identifier":{"url":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/CombiningModels","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText\/combine(_:weights:)","doc:\/\/ChainLetter\/documentation\/ChainLetter\/Chain\/combine(_:weights:)","doc:\/\/ChainLetter\/documentation\/ChainLetter\/Chain\/CombineError"]},{"title":"Advanced Usage","generated":true,"anchor":"Advanced-Usage","identifiers":["doc:\/\/ChainLetter\/documentation\/ChainLetter\/CustomizingSentenceSplitting","doc:\/\/ChainLetter\/documentation\/ChainLetter\/PersistingModels"]}],"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/ChainLetter\/documentation\/ChainLetter"]]},"references":{"doc://ChainLetter/documentation/ChainLetter/Chain":{"navigatorTitle":[{"text":"Chain","kind":"identifier"}],"url":"\/documentation\/chainletter\/chain","title":"Chain","abstract":[{"type":"text","text":"A Markov chain representing a sequence model with explicit begin and end states."},{"type":"text","text":" "},{"type":"text","text":"Used to model processes like sentences that have natural beginnings and endings."}],"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/Chain","type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"Chain","kind":"identifier"}]},"doc://ChainLetter/documentation/ChainLetter/MarkovText/combine(_:weights:)":{"title":"combine(_:weights:)","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"combine","kind":"identifier"},{"text":"([","kind":"text"},{"text":"MarkovText","kind":"typeIdentifier","preciseIdentifier":"s:11ChainLetter10MarkovTextV"},{"text":"], ","kind":"text"},{"text":"weights","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":"]?) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"MarkovText","preciseIdentifier":"s:11ChainLetter10MarkovTextV","kind":"typeIdentifier"}],"url":"\/documentation\/chainletter\/markovtext\/combine(_:weights:)","abstract":[{"text":"Combines multiple MarkovText models into a single model with weighted transitions","type":"text"}],"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText\/combine(_:weights:)","type":"topic","kind":"symbol"},"doc://ChainLetter/documentation/ChainLetter/Chain/combine(_:weights:)":{"title":"combine(_:weights:)","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"combine","kind":"identifier"},{"text":"([","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:11ChainLetter0A0V","text":"Chain"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"weights"},{"text":": [","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":"]?) ","kind":"text"},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"text":"Chain","preciseIdentifier":"s:11ChainLetter0A0V","kind":"typeIdentifier"}],"url":"\/documentation\/chainletter\/chain\/combine(_:weights:)","abstract":[{"text":"Combines multiple chains into a single chain with weighted transitions","type":"text"}],"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/Chain\/combine(_:weights:)","type":"topic","kind":"symbol"},"doc://ChainLetter/documentation/ChainLetter":{"role":"collection","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A Swift library for building Markov chain text generators."}],"url":"\/documentation\/chainletter","identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter","title":"ChainLetter"},"doc://ChainLetter/documentation/ChainLetter/PersistingModels":{"title":"Persisting Models","role":"article","url":"\/documentation\/chainletter\/persistingmodels","abstract":[{"text":"Save and load Markov models for later use.","type":"text"}],"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/PersistingModels","type":"topic","kind":"article"},"doc://ChainLetter/documentation/ChainLetter/CustomizingSentenceSplitting":{"kind":"article","type":"topic","abstract":[{"text":"Handle non-standard text formats like chat logs, poetry, and structured data.","type":"text"}],"url":"\/documentation\/chainletter\/customizingsentencesplitting","role":"article","title":"Customizing Sentence Splitting","identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/CustomizingSentenceSplitting"},"doc://ChainLetter/documentation/ChainLetter/Chain/CombineError":{"kind":"symbol","type":"topic","identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/Chain\/CombineError","navigatorTitle":[{"text":"CombineError","kind":"identifier"}],"url":"\/documentation\/chainletter\/chain\/combineerror","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"CombineError"}],"title":"Chain.CombineError","abstract":[{"text":"Error thrown when combining chains fails","type":"text"}]}}}