esholds","level":3,"text":"Adjusting Thresholds"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more original output, use stricter thresholds:"}]},{"type":"codeListing","syntax":"swift","code":["if let sentence = model.makeSentence(","    maxOverlapRatio: 0.5,  \/\/ Max 50% overlap","    maxOverlapTotal: 8     \/\/ Max 8 words",") {","    print(sentence)","}"]},{"type":"heading","anchor":"Disabling-Overlap-Checking","level":3,"text":"Disabling Overlap Checking"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For maximum generation success (at the cost of potentially copying the source), disable checking entirely:"}]},{"code":["if let sentence = model.makeSentence(testOutput: false) {","    print(sentence)","}"],"type":"codeListing","syntax":"swift"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Disabling overlap checking is useful for small corpora where overlap is unavoidable, but the output may be identical to your source text."}]}],"type":"aside","style":"important","name":"Important"},{"text":"Performance Optimization","type":"heading","anchor":"Performance-Optimization","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"For applications that generate many sentences, compile the model first:"}]},{"type":"codeListing","syntax":"swift","code":["var model = MarkovText(corpus)","model.compile()","","\/\/ Generation is now faster","for _ in 0..<1000 {","    if let sentence = model.makeSentence() {","        print(sentence)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Compilation pre-computes cumulative probability distributions, improving generation speed by approximately 10-20% for large models."}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText\/makeSentence(initState:tries:maxOverlapRatio:maxOverla