{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"ChainLetter provides several methods for generating text, from simple random sentences to length-constrained output suitable for tweets or UI elements.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Basic-Sentence-Generation","type":"heading","text":"Basic Sentence Generation"},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText\/makeSentence(initState:tries:maxOverlapRatio:maxOverlapTotal:testOutput:maxWords:minWords:)","type":"reference"},{"type":"text","text":" method generates a single sentence:"}],"type":"paragraph"},{"type":"codeListing","code":["if let sentence = model.makeSentence() {","    print(sentence)","}"],"syntax":"swift"},{"text":"Controlling Attempts","type":"heading","level":3,"anchor":"Controlling-Attempts"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Generation may fail if the random walk produces text too similar to the original corpus. Increase "},{"code":"tries","type":"codeVoice"},{"text":" for difficult corpora:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["if let sentence = model.makeSentence(tries: 50) {","    print(sentence)","}"]},{"type":"heading","level":3,"text":"Word Count Constraints","anchor":"Word-Count-Constraints"},{"type":"paragraph","inlineContent":[{"text":"Limit the length of generated sentences by word count:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ At least 5 words","if let sentence = model.makeSentence(minWords: 5) {","    print(sentence)","}","","\/\/ Between 5 and 15 words","if let sentence = model.makeSentence(minWords: 5, maxWords: 15) {","    print(sentence)","}"]},{"type":"heading","level":2,"text":"Character-Limited Sentences","anchor":"Character-Limited-Sentences"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText\/makeShortSentence(maxChars:minChars:tries:maxOverlapRatio:maxOverlapTotal:testOutput:)","type":"reference"},{"type":"text","text":" when you need sentences that fit within a character limit:"}]},{"code":["\/\/ Tweet-length (max 280 characters)","if let tweet = model.makeShortSentence(maxChars: 280) {","    print(tweet)","}","","\/\/ Between 100 and 280 characters","if let tweet = model.makeShortSentence(maxChars: 280, minChars: 100) {","    print(tweet)","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Starting-with-a-Specific-Phrase","text":"Starting with a Specific Phrase","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText\/makeSentenceWithStart(_:strict:tries:maxOverlapRatio:maxOverlapTotal:testOutput:)","isActive":true},{"text":" to generate sentences beginning with a specific word or phrase:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["if let sentence = model.makeSentenceWithStart(\"The quick\") {","    print(sentence)","    \/\/ \"The quick brown fox jumps over the lazy dog.\"","}"]},{"level":3,"type":"heading","anchor":"Strict-vs-Non-Strict-Mode","text":"Strict vs. Non-Strict Mode"},{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"text":"strict mode","type":"text"}],"type":"strong"},{"text":" (default), the phrase must appear at the beginning of sentences in your corpus:","type":"text"}]},{"syntax":"swift","code":["\/\/ Only works if sentences start with \"Once upon\"","if let sentence = model.makeSentenceWithStart(\"Once upon\", strict: true) {","    print(sentence)","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"text":"non-strict mode","type":"text"}],"type":"strong"},{"type":"text","text":", the phrase can appear anywhere in the model’s states:"}]},{"code":["\/\/ Works if \"brown fox\" appears anywhere","if let sentence = model.makeSentenceWithStart(\"brown fox\", strict: false) {","    print(sentence)","}"],"syntax":"swift","type":"codeListing"},{"content":[{"inlineContent":[{"type":"text","text":"The starting phrase must contain at most "},{"type":"codeVoice","code":"stateSize"},{"type":"text","text":" words."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Note"},{"type":"heading","text":"Overlap Detection","anchor":"Overlap-Detection","level":2},{"inlineContent":[{"text":"By default, ChainLetter rejects sentences that too closely match the original corpus. This prevents generating exact copies of your input.","type":"text"}],"type":"paragraph"},{"text":"How It Works","level":3,"anchor":"How-It-Works","type":"heading"},{"inlineContent":[{"type":"text","text":"The algorithm checks if any contiguous sequence of words in the generated sentence appears in the original text. The thresholds are:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"maxOverlapRatio","type":"text"}],"type":"strong"},{"type":"text","text":": Maximum overlap as a fraction of sentence length (default: 0.7)"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"maxOverlapTotal","type":"text"}]},{"text":": Maximum absolute overlap in words (default: 15)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The effective limit is the smaller of these two values."}]},{"level":3,"anchor":"Adjusting-Thresholds","text":"Adjusting Thresholds","type":"heading"},{"inlineContent":[{"text":"For more original output, use stricter thresholds:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["if let sentence = model.makeSentence(","    maxOverlapRatio: 0.5,  \/\/ Max 50% overlap","    maxOverlapTotal: 8     \/\/ Max 8 words",") {","    print(sentence)","}"]},{"level":3,"anchor":"Disabling-Overlap-Checking","type":"heading","text":"Disabling Overlap Checking"},{"inlineContent":[{"type":"text","text":"For maximum generation success (at the cost of potentially copying the source), disable checking entirely:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["if let sentence = model.makeSentence(testOutput: false) {","    print(sentence)","}"]},{"name":"Important","type":"aside","content":[{"inlineContent":[{"text":"Disabling overlap checking is useful for small corpora where overlap is unavoidable, but the output may be identical to your source text.","type":"text"}],"type":"paragraph"}],"style":"important"},{"level":2,"anchor":"Performance-Optimization","type":"heading","text":"Performance Optimization"},{"inlineContent":[{"type":"text","text":"For applications that generate many sentences, compile the model first:"}],"type":"paragraph"},{"type":"codeListing","code":["var model = MarkovText(corpus)","model.compile()","","\/\/ Generation is now faster","for _ in 0..<1000 {","    if let sentence = model.makeSentence() {","        print(sentence)","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Compilation pre-computes cumulative probability distributions, improving generation speed by approximately 10-20% for large models."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/chainletter\/textgeneration"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Article","modules":[{"name":"ChainLetter"}],"role":"article","title":"Text Generation"},"abstract":[{"text":"Generate sentences with various constraints and options.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/TextGeneration"},"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation