/ Between 5 and 15 words","if let sentence = model.makeSentence(minWords: 5, maxWords: 15) {","    print(sentence)","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Character-Limited-Sentences","type":"heading","level":2,"text":"Character-Limited Sentences"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText\/makeShortSentence(maxChars:minChars:tries:maxOverlapRatio:maxOverlapTotal:testOutput:)","isActive":true},{"type":"text","text":" when you need sentences that fit within a character limit:"}]},{"code":["\/\/ Tweet-length (max 280 characters)","if let tweet = model.makeShortSentence(maxChars: 280) {","    print(tweet)","}","","\/\/ Between 100 and 280 characters","if let tweet = model.makeShortSentence(maxChars: 280, minChars: 100) {","    print(tweet)","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Starting with a Specific Phrase","anchor":"Starting-with-a-Specific-Phrase","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ChainLetter\/documentation\/ChainLetter\/MarkovText\/makeSentenceWithStart(_:strict:tries:maxOverlapRatio:maxOverlapTotal:testOutput:)"},{"type":"text","text":" to generate sentences beginning with a specific word or phrase:"}]},{"type":"codeListing","syntax":"swift","code":["if let sentence = model.makeSentenceWithStart(\"The quick\") {","    print(sentence)","    \/\/ \"The quick brown fox jumps over the lazy dog.\"","}"]},{"type":"heading","level":3,"anchor":"Strict-vs-Non-Strict-Mode","text":"Strict vs. Non-Strict Mode"},{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"strict mode"}]},{"type":"text","text":" (default), the phrase must appear at the beginning of sentences in your corpus:"}]},{"code":["\/\/ Only works if sentences start with \"Once 